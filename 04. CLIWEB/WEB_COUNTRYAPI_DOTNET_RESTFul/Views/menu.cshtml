@* Menú principal: una tarjeta por opción, en el orden del ECUD1. *@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["titulo"] = "Menú principal";
    ViewData["pantalla"] = "menu";
}
<h1 class="titulo">Menú principal</h1>
<p class="descripcion">Elija una opción.</p>
@await Html.PartialAsync("~/Views/Shared/_Avisos.cshtml")

<div class="menu">
    <a class="opcion" href="/importar">
        <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19.35,10.04C18.67,6.59 15.64,4 12,4 9.11,4 6.6,5.64 5.35,8.04 2.34,8.36 0,10.91 0,14c0,3.31 2.69,6 6,6h13c2.76,0 5,-2.24 5,-5 0,-2.64 -2.05,-4.78 -4.65,-4.96zM17,13l-5,5 -5,-5h3V9h4v4h3z"/></svg></span>
        <span><span class="opcion__titulo">Importar países</span>
            <span class="opcion__texto">Trae todos los países desde la API REST Countries.</span></span>
    </a>
    <a class="opcion" href="/consultar">
        <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5,14h-0.79l-0.28,-0.27C15.41,12.59 16,11.11 16,9.5 16,5.91 13.09,3 9.5,3S3,5.91 3,9.5 5.91,16 9.5,16c1.61,0 3.09,-0.59 4.23,-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99,-5zM9.5,14C7.01,14 5,11.99 5,9.5S7.01,5 9.5,5 14,7.01 14,9.5 11.99,14 9.5,14z"/></svg></span>
        <span><span class="opcion__titulo">Consultar país en la API</span>
            <span class="opcion__texto">Busca un país por nombre en la API y guárdelo.</span></span>
    </a>
    <a class="opcion" href="/paises">
        <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3,13h2v-2H3v2zM3,17h2v-2H3v2zM3,9h2V7H3v2zM7,13h14v-2H7v2zM7,17h14v-2H7v2zM7,7v2h14V7H7z"/></svg></span>
        <span><span class="opcion__titulo">Países</span>
            <span class="opcion__texto">Lista, registra, edita y elimina los países guardados.</span></span>
    </a>
    <a class="opcion" href="/buscar">
        <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M10,18h4v-2h-4v2zM3,6v2h18V6H3zM6,13h12v-2H6v2z"/></svg></span>
        <span><span class="opcion__titulo">Buscar y filtrar</span>
            <span class="opcion__texto">Busca por nombre, capital y región con filtros dinámicos.</span></span>
    </a>
    <a class="opcion" href="/reportes">
        <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19,3H5c-1.1,0 -2,0.9 -2,2v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5c0,-1.1 -0.9,-2 -2,-2zM9,17H7v-7h2v7zM13,17h-2V7h2v10zM17,17h-2v-4h2v4z"/></svg></span>
        <span><span class="opcion__titulo">Reportes</span>
            <span class="opcion__texto">Países por región, país más poblado y promedio poblacional.</span></span>
    </a>
    <a class="opcion" href="/universidades">
        <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M5,13.18v4L12,21l7,-3.82v-4L12,17l-7,-3.82zM12,3L1,9l11,6 9,-4.91V17h2V9L12,3z"/></svg></span>
        <span><span class="opcion__titulo">Universidades</span>
            <span class="opcion__texto">Importa y consulta las universidades de un país.</span></span>
    </a>
    <form method="post" action="/logout">
        @Html.AntiForgeryToken()
        <button class="opcion" type="submit">
            <span class="opcion__icono" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M10.09,15.59L11.5,17l5,-5 -5,-5 -1.41,1.41L12.67,11H3v2h9.67l-2.58,2.59zM19,3H5c-1.11,0 -2,0.9 -2,2v4h2V5h14v14H5v-4H3v4c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V5c0,-1.1 -0.9,-2 -2,-2z"/></svg></span>
            <span><span class="opcion__titulo">Cerrar sesión</span>
                <span class="opcion__texto">Termina la sesión y vuelve al inicio.</span></span>
        </button>
    </form>
</div>
