@*
  Marco de cada pantalla con sesión (inicio.jspf y fin.jspf de Java): <head> y barra superior
  azul con la navegación, el usuario, «Cerrar sesión» y el indicador del servidor. Cada página
  define ViewData["titulo"] y ViewData["pantalla"].
*@
@{
    string? pantalla = ViewData["pantalla"] as string;
    string? usuario = ModulosSesion.Existente(Context)?.Sesion.Nombre;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["titulo"] · CountryAPI</title>
    <link rel="stylesheet" href="/css/countryapi.css">
    <link rel="icon" href="/css/globo.svg" type="image/svg+xml">
</head>
<body>
<a class="solo-lectores" href="#contenido">Ir al contenido</a>
<header class="barra">
    <div class="barra__fila">
        <a class="marca" href="/menu" title="Menú principal">
            <span class="marca__logo" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10,-4.48 10,-10S17.52,2 12,2zM11,19.93c-3.95,-0.49 -7,-3.85 -7,-7.93 0,-0.62 0.08,-1.21 0.21,-1.79L9,15v1c0,1.1 0.9,2 2,2v1.93zM17.9,17.39c-0.26,-0.81 -1,-1.39 -1.9,-1.39h-1v-3c0,-0.55 -0.45,-1 -1,-1H8v-2h2c0.55,0 1,-0.45 1,-1V7h2c1.1,0 2,-0.9 2,-2v-0.41c2.93,1.19 5,4.06 5,7.41 0,2.08 -0.8,3.97 -2.1,5.39z"/></svg>
            </span>
            CountryAPI
        </a>
        <nav class="navegacion" aria-label="Opciones">
            <a href="/importar" aria-current="@(pantalla == "importar" ? "page" : null)">Importar países</a>
            <a href="/consultar" aria-current="@(pantalla == "consultar" ? "page" : null)">Consultar en la API</a>
            <a href="/paises" aria-current="@(pantalla == "paises" ? "page" : null)">Países</a>
            <a href="/buscar" aria-current="@(pantalla == "buscar" ? "page" : null)">Buscar y filtrar</a>
            <a href="/reportes" aria-current="@(pantalla == "reportes" ? "page" : null)">Reportes</a>
            <a href="/universidades" aria-current="@(pantalla == "universidades" ? "page" : null)">Universidades</a>
        </nav>
        <div class="barra__usuario">
            <span class="barra__nombre">@usuario</span>
            <form class="en-linea" method="post" action="/logout">
                @Html.AntiForgeryToken()
                <button class="btn btn--barra" type="submit">Cerrar sesión</button>
            </form>
        </div>
    </div>
    <div class="barra__estado">
        <div class="barra__fila">
            <span class="indicador" data-indicador="/estado" role="status">
                <span class="indicador__punto" aria-hidden="true"></span>
                <span class="indicador__texto">Comprobando el servidor...</span>
            </span>
        </div>
    </div>
</header>
<main class="contenido" id="contenido">
@RenderBody()
</main>
<script src="/js/countryapi.js"></script>
</body>
</html>
