@* Reportes (ECUD6): país más poblado y dos tablas por región. *@
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["titulo"] = "Reportes";
    ViewData["pantalla"] = "reportes";
    var reporte = ViewData[ReporteVistaWeb.REPORTE] as Reporte;
}
<h1 class="titulo">Reportes</h1>
<p class="descripcion">Estadísticas calculadas sobre los países almacenados.</p>
@await Html.PartialAsync("~/Views/Shared/_Avisos.cshtml")

<a class="btn btn--secundario" href="/reportes">Actualizar</a>

@if (reporte != null)
{
    <div class="tarjeta" style="margin-top:16px">
        <h2 class="tarjeta__titulo">País más poblado</h2>
        @if (reporte.PaisMasPoblado != null)
        {
            <span class="cifra__valor">@reporte.PaisMasPoblado.Nombre</span>
            <span class="cifra__etiqueta">@Formato.Entero(reporte.PaisMasPoblado.Poblacion)
                habitantes · @reporte.PaisMasPoblado.Region</span>
        }
        else
        {
            <span class="cifra__valor">—</span>
        }
    </div>

    <div class="cifras" style="margin-top:8px; align-items:start">
        <section>
            <h2 class="subtitulo">Cantidad de países por región</h2>
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead><tr><th scope="col">Región</th><th scope="col" class="numero">Países</th></tr></thead>
                    <tbody>
                    @foreach (ConteoRegion fila in reporte.PaisesPorRegion)
                    {
                        <tr><td>@fila.Region</td>
                            <td class="numero">@Formato.Entero(fila.Cantidad)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
        <section>
            <h2 class="subtitulo">Promedio poblacional por región</h2>
            <div class="tabla-contenedor">
                <table class="tabla">
                    <thead><tr><th scope="col">Región</th><th scope="col" class="numero">Promedio de población</th></tr></thead>
                    <tbody>
                    @foreach (PromedioRegion fila in reporte.PromedioPorRegion)
                    {
                        <tr><td>@fila.Region</td>
                            <td class="numero">@Formato.Entero(fila.PromedioPoblacion)</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}
