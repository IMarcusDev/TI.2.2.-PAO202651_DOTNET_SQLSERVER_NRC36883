@* Página para 403, 404 y 500: nunca muestra trazas. *@
@{
    Layout = null;
    int codigo = ViewData["codigo"] as int? ?? 500;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CountryAPI</title>
    <link rel="stylesheet" href="/css/countryapi.css">
</head>
<body>
<header class="barra"><div class="barra__fila"><a class="marca" href="/menu">CountryAPI</a></div></header>
<main class="contenido">
    <div class="aviso aviso--error" role="alert">
        @switch (codigo)
        {
            case 403:
                @:La solicitud no es válida o la página caducó. Vuelva a intentarlo desde el menú.
                break;
            case 404:
                @:La página no existe.
                break;
            default:
                @:Ocurrió un error inesperado, intente nuevamente
                break;
        }
    </div>
    <a class="btn" href="/menu">Ir al menú principal</a>
</main>
</body>
</html>
