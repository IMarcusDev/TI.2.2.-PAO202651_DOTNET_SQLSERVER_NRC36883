<?xml version="1.0" encoding="utf-8" ?>
<v:PantallaBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:v="clr-namespace:ec.edu.monster.vista"
                x:Class="ec.edu.monster.vista.PaisPantalla">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,16,16,0">
            <Label Style="{StaticResource Suave}"
                   Text="Países almacenados en la base de datos. Toque un país para editarlo o eliminarlo." />
            <v:Aviso x:Name="AvisoPantalla" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                <v:Campo x:Name="CampoFiltro" Etiqueta="Buscar" Icono="ic_consultar_azul.png" TipoRetorno="Search" BotonBorrar="True" />
                <Button x:Name="BotonBuscar" Grid.Column="1" Style="{StaticResource BotonPrimario}" Text="Buscar"
                        VerticalOptions="End" />
            </Grid>
            <Label x:Name="TotalPaises" Style="{StaticResource Suave}" Margin="0,8" />
        </VerticalStackLayout>

        <CollectionView x:Name="ListaPaises" Grid.Row="1">
            <CollectionView.Footer>
                <!-- Espacio para que el botón «Nuevo» no tape la última tarjeta -->
                <BoxView HeightRequest="88" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Botón flotante «Nuevo» -->
        <Button x:Name="BotonNuevo" Grid.Row="1" Text="Nuevo" ImageSource="ic_agregar_blanco.png"
                ContentLayout="Left,8" BackgroundColor="{StaticResource Azul}" TextColor="{StaticResource Blanco}"
                FontSize="16" FontFamily="sans-serif-medium" CornerRadius="16" HeightRequest="56" Padding="20,0"
                HorizontalOptions="End" VerticalOptions="End" Margin="16" Shadow="{Shadow Radius=8, Opacity=0.3, Offset='0,3'}" />
    </Grid>
</v:PantallaBase>
