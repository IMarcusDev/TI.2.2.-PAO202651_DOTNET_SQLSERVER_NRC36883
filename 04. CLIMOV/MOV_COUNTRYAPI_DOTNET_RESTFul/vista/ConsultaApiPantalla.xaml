<?xml version="1.0" encoding="utf-8" ?>
<v:PantallaBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:v="clr-namespace:ec.edu.monster.vista"
                x:Class="ec.edu.monster.vista.ConsultaApiPantalla">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,16,16,12">
            <Label Style="{StaticResource Suave}"
                   Text="Consulta REST Countries por nombre (por ejemplo «ecuador») y guarde el país elegido." />
            <v:Aviso x:Name="AvisoPantalla" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                <v:Campo x:Name="CampoNombre" Etiqueta="Nombre del país" Icono="ic_consultar_azul.png" TipoRetorno="Search" BotonBorrar="True" />
                <Button x:Name="BotonConsultar" Grid.Column="1" Style="{StaticResource BotonPrimario}" Text="Consultar"
                        VerticalOptions="End" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView x:Name="ListaApi" Grid.Row="1">
            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</v:PantallaBase>
