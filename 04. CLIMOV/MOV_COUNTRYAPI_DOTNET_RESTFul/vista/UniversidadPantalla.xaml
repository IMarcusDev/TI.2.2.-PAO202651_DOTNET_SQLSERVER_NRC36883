<?xml version="1.0" encoding="utf-8" ?>
<v:PantallaBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                xmlns:v="clr-namespace:ec.edu.monster.vista"
                x:Class="ec.edu.monster.vista.UniversidadPantalla">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="16,16,16,0">
            <Label Style="{StaticResource Suave}"
                   Text="Importa desde la API de universidades las de un país (escrito en inglés) y consulta las guardadas." />
            <v:Aviso x:Name="AvisoPantalla" />
            <v:Campo x:Name="CampoPais" Etiqueta="País (en inglés)" Texto="Ecuador" TipoRetorno="Search" BotonBorrar="True" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                <Button x:Name="BotonImportar" Style="{StaticResource BotonPrimario}" Text="Importar" />
                <Button x:Name="BotonVerGuardadas" Grid.Column="1" Style="{StaticResource BotonSecundario}" Text="Ver guardadas" />
            </Grid>
            <Label x:Name="TotalUniversidades" Style="{StaticResource Suave}" Margin="0,8" />
        </VerticalStackLayout>

        <CollectionView x:Name="ListaUniversidades" Grid.Row="1" SelectionMode="None">
            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</v:PantallaBase>
