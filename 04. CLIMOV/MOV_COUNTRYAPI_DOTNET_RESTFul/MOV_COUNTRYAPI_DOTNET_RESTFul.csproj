<Project Sdk="Microsoft.NET.Sdk">

	<!-- Cliente móvil (.NET MAUI, Android) de CountryAPI. Consume solo el servidor RESTful. -->
	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>ec.edu.monster</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>CountryAPI</ApplicationTitle>
		<!-- Distinto del cliente Java (ec.edu.monster.countryapi) para poder tener los dos instalados. -->
		<ApplicationId>ec.edu.monster.countryapi.dotnet</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 7.0, como el minSdk 24 del cliente Java. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>

		<!-- Dirección inicial del servidor. El emulador ve al equipo anfitrión como 10.0.2.2.
		     Para otra: dotnet build -p:Servidor=http://192.168.1.20:5088/api -->
		<Servidor Condition="'$(Servidor)' == ''">http://10.0.2.2:5088/api</Servidor>
	</PropertyGroup>

	<ItemGroup>
		<!-- ConfigServidor la lee de los metadatos del ensamblado. -->
		<AssemblyMetadata Include="Servidor" Value="$(Servidor)" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F4E79" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F4E79" BaseSize="96,96" />
		<MauiImage Include="Resources\Images\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<!-- Las pruebas viven en pruebas/ (exigencia del curso), pero no forman parte del APK. -->
	<ItemGroup>
		<Compile Remove="pruebas\**" />
		<None Remove="pruebas\**" />
		<EmbeddedResource Remove="pruebas\**" />
		<MauiXaml Remove="pruebas\**" />
	</ItemGroup>

</Project>
