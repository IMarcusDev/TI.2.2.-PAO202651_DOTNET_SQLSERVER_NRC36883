<!-- «Importar países» (ECUD2). Autor: Escobar Marcos -->
<vista:PanelBase x:Class="ec.edu.monster.vista.ImportacionPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vista="clr-namespace:ec.edu.monster.vista"
                 Padding="24,20">
    <StackPanel>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Importar países" Style="{StaticResource Titulo}" />
            <TextBlock Text="Trae todos los países de la API REST Countries. Los nuevos se registran y los existentes se actualizan, sin duplicar."
                       Style="{StaticResource Suave}" Margin="0,4,0,0" />
            <vista:Alerta x:Name="AlertaPantalla" Margin="0,12,0,0" />
        </StackPanel>
        <Button x:Name="Importar" Content="Importar países" Style="{StaticResource BotonPrimario}"
                HorizontalAlignment="Left" />
        <UniformGrid x:Name="Resumen" Columns="3" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Style="{StaticResource CajaCifra}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Recibidos de la API" Style="{StaticResource Suave}" />
                    <TextBlock x:Name="Recibidos" Text="0" Style="{StaticResource Cifra}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CajaCifra}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Registrados (nuevos)" Style="{StaticResource Suave}" />
                    <TextBlock x:Name="Registrados" Text="0" Style="{StaticResource Cifra}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CajaCifra}">
                <StackPanel>
                    <TextBlock Text="Actualizados" Style="{StaticResource Suave}" />
                    <TextBlock x:Name="Actualizados" Text="0" Style="{StaticResource Cifra}" />
                </StackPanel>
            </Border>
        </UniformGrid>
    </StackPanel>
</vista:PanelBase>
