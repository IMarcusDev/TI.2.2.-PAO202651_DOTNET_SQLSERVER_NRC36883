<!-- Universidades (ECUD10). Autor: Escobar Marcos -->
<vista:PanelBase x:Class="ec.edu.monster.vista.UniversidadPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vista="clr-namespace:ec.edu.monster.vista"
                 Padding="24,20">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Universidades" Style="{StaticResource Titulo}" />
            <TextBlock Text="Importa desde la API de universidades las de un país (escrito en inglés) y consulta las guardadas."
                       Style="{StaticResource Suave}" Margin="0,4,0,0" />
            <vista:Alerta x:Name="AlertaPantalla" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="País (en inglés)" Style="{StaticResource Etiqueta}" />
            <TextBox x:Name="CampoPais" Width="210" Margin="8,0" Text="Ecuador" />
            <Button x:Name="Importar" Content="Importar" Style="{StaticResource BotonPrimario}" />
            <Button x:Name="VerGuardadas" Content="Ver guardadas" Style="{StaticResource BotonSecundario}" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="Total" DockPanel.Dock="Bottom" Style="{StaticResource Suave}" Margin="0,12,0,0" Text=" " />
        <DataGrid x:Name="Tabla" Style="{StaticResource Tabla}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="2*" />
                <DataGridTextColumn Header="Dominio" Binding="{Binding Dominio}" Width="*" />
                <DataGridTextColumn Header="Sitio web" Binding="{Binding SitioWeb}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</vista:PanelBase>
