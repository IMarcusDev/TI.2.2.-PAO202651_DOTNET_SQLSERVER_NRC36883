<!-- «Buscar y filtrar» (ECUD5): nombre, capital y filtros de región. Autor: Escobar Marcos -->
<vista:PanelBase x:Class="ec.edu.monster.vista.BusquedaPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vista="clr-namespace:ec.edu.monster.vista"
                 Padding="24,20">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Buscar y filtrar" Style="{StaticResource Titulo}" />
            <TextBlock Text="Combine nombre, capital y región. Al elegir una región la tabla se actualiza al momento."
                       Style="{StaticResource Suave}" Margin="0,4,0,0" />
            <vista:Alerta x:Name="AlertaPantalla" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}" />
                <TextBox x:Name="Nombre" Width="190" Margin="8,0" />
                <TextBlock Text="Capital" Style="{StaticResource Etiqueta}" />
                <TextBox x:Name="Capital" Width="190" Margin="8,0" />
                <Button x:Name="BotonBuscar" Content="Buscar" Style="{StaticResource BotonPrimario}" />
            </StackPanel>
            <WrapPanel x:Name="Filtros" Orientation="Horizontal" Margin="0,10,0,0" />
        </StackPanel>
        <TextBlock x:Name="Total" DockPanel.Dock="Bottom" FontWeight="Bold" Foreground="{StaticResource Azul}"
                   Margin="0,12,0,0" Text=" " />
        <DataGrid x:Name="Tabla" Style="{StaticResource Tabla}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Capital" Binding="{Binding Capital}" Width="*" />
                <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="0.7*" />
                <DataGridTextColumn Header="Subregión" Binding="{Binding SubRegion}" Width="*" />
                <DataGridTextColumn Header="Población" Width="0.8*" SortMemberPath="Poblacion"
                                    Binding="{Binding Poblacion, Converter={StaticResource FormatoNumero}}"
                                    HeaderStyle="{StaticResource EncabezadoNumero}" ElementStyle="{StaticResource TextoNumero}" />
                <DataGridTextColumn Header="Área (km²)" Width="0.8*" SortMemberPath="Area"
                                    Binding="{Binding Area, Converter={StaticResource FormatoNumero}}"
                                    HeaderStyle="{StaticResource EncabezadoNumero}" ElementStyle="{StaticResource TextoNumero}" />
                <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="1.2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</vista:PanelBase>
