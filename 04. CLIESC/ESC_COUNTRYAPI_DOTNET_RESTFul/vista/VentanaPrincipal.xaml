<!--
    Única ventana de la aplicación: el inicio de sesión o la aplicación (barra superior azul con la
    navegación y el usuario, la pantalla activa) y la barra inferior con el indicador del servidor.
    Autor: Escobar Marcos
-->
<Window x:Class="ec.edu.monster.vista.VentanaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vista="clr-namespace:ec.edu.monster.vista"
        Title="CountryAPI" Width="1240" Height="760" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Fondo}"
        FontFamily="{StaticResource Fuente}" FontSize="14" Foreground="{StaticResource Texto}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Inicio de sesión -->
        <ContentControl x:Name="TarjetaLogin" Grid.Row="0" Focusable="False" />

        <!-- Aplicación -->
        <DockPanel x:Name="TarjetaApp" Grid.Row="0" Visibility="Collapsed">
            <Border DockPanel.Dock="Top" Background="{StaticResource Azul}" Padding="16,6,12,6">
                <DockPanel LastChildFill="True">
                    <Button x:Name="Marca" DockPanel.Dock="Left" Content="CountryAPI" Style="{StaticResource BotonBarra}"
                            FontSize="16" ToolTip="Menú principal" Click="AlElegirMarca" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="Usuario" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Button x:Name="BotonCerrarSesion" Content="Cerrar sesión" Style="{StaticResource BotonBarra}"
                                BorderBrush="White" Padding="12,6" />
                    </StackPanel>
                    <WrapPanel x:Name="Navegacion" VerticalAlignment="Center" Margin="2,0" />
                </DockPanel>
            </Border>
            <Grid x:Name="Pantallas" Background="{StaticResource Fondo}" />
        </DockPanel>

        <!-- Barra inferior: indicador del servidor y progreso -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0"
                Padding="16,6">
            <DockPanel>
                <Grid x:Name="Progreso" DockPanel.Dock="Right" Width="180" Height="18" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Foreground="{StaticResource Azul}" />
                    <TextBlock Text="Procesando..." FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <vista:IndicadorServidor x:Name="Indicador" />
                    <TextBlock x:Name="UrlServidor" Style="{StaticResource Suave}" Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Capa transparente que bloquea el ratón mientras se procesa una petición (RNF-012) -->
        <Border x:Name="Bloqueo" Grid.RowSpan="2" Background="Transparent" Cursor="Wait" Visibility="Collapsed" />
    </Grid>
</Window>
