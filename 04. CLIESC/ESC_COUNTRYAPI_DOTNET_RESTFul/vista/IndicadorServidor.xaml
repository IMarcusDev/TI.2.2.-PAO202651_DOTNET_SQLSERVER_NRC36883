<!-- Indicador de la barra inferior: verde si el servidor responde, rojo si no. Autor: Escobar Marcos -->
<UserControl x:Class="ec.edu.monster.vista.IndicadorServidor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="Punto" Width="10" Height="10" Fill="{StaticResource Borde}" VerticalAlignment="Center" />
        <TextBlock x:Name="Texto" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextoSuave}"
                   VerticalAlignment="Center" Text="Comprobando el servidor..." />
    </StackPanel>
</UserControl>
