<!-- Países (ECUD4): DataGrid con los siete datos, campo «Buscar» y botones Nuevo, Editar y Eliminar. Autor: Escobar Marcos -->
<vista:PanelBase x:Class="ec.edu.monster.vista.PaisPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vista="clr-namespace:ec.edu.monster.vista"
                 Padding="24,20">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Países" Style="{StaticResource Titulo}" />
            <TextBlock Text="Países almacenados en la base de datos. Busque por nombre o mantenga el listado."
                       Style="{StaticResource Suave}" Margin="0,4,0,0" />
            <vista:Alerta x:Name="AlertaPantalla" Margin="0,12,0,0" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="Nuevo" Content="_Nuevo" Style="{StaticResource BotonPrimario}" />
                <Button x:Name="Editar" Content="_Editar" Style="{StaticResource BotonSecundario}" Margin="8,0,0,0" />
                <Button x:Name="Eliminar" Content="E_liminar" Style="{StaticResource BotonPeligro}" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Buscar" Style="{StaticResource Etiqueta}" />
                <TextBox x:Name="Filtro" Width="280" Margin="8,0" />
                <Button x:Name="BotonBuscar" Content="_Buscar" Style="{StaticResource BotonPrimario}" />
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="Total" DockPanel.Dock="Bottom" Style="{StaticResource Suave}" Margin="0,12,0,0" Text=" " />
        <DataGrid x:Name="Tabla" Style="{StaticResource Tabla}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Capital" Binding="{Binding Capital}" Width="*" />
                <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="0.7*" />
                <DataGridTextColumn Header="Subregión" Binding="{Binding SubRegion}" Width="*" />
                <DataGridTextColumn Header="Población" Width="0.8*" SortMemberPath="Poblacion"
                                    Binding="{Binding Poblacion, Converter={StaticResource FormatoNumero}}"
                                    HeaderStyle="{StaticResource EncabezadoNumero}" ElementStyle="{StaticResource TextoNumero}" />
                <DataGridTextColumn Header="Área (km²)" Width="0.8*" SortMemberPath="Area"
                                    Binding="{Binding Area, Converter={StaticResource FormatoNumero}}"
                                    HeaderStyle="{StaticResource EncabezadoNumero}" ElementStyle="{StaticResource TextoNumero}" />
                <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="1.2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</vista:PanelBase>
