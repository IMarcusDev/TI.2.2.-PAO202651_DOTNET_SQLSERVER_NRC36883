<!-- Formulario modal con los siete datos del país (ECUD4). Autor: Escobar Marcos -->
<Window x:Class="ec.edu.monster.vista.FormularioPaisDialogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Blanco}"
        FontFamily="{StaticResource Fuente}" FontSize="14" Foreground="{StaticResource Texto}">
    <StackPanel>
        <Grid Margin="24,20,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Nombre *" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="Nombre" Margin="0,5" />
            <TextBlock Grid.Row="1" Text="Capital" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Capital" Margin="0,5" />
            <TextBlock Grid.Row="2" Text="Región *" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="Region" Margin="0,5" />
            <TextBlock Grid.Row="3" Text="Subregión" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="Subregion" Margin="0,5" />
            <TextBlock Grid.Row="4" Text="Población *" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="Poblacion" Margin="0,5" />
            <TextBlock Grid.Row="5" Text="Área (km²)" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="Area" Margin="0,5" />
            <TextBlock Grid.Row="6" Text="Moneda" Style="{StaticResource Etiqueta}" Margin="0,5,12,5" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="Moneda" Margin="0,5" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,20">
            <Button Content="Cancelar" Style="{StaticResource BotonSecundario}" IsCancel="True" />
            <Button Content="Guardar" Style="{StaticResource BotonPrimario}" IsDefault="True" Margin="8,0,0,0"
                    Click="AlGuardar" />
        </StackPanel>
    </StackPanel>
</Window>
