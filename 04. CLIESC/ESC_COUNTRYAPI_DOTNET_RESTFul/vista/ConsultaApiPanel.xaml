<!-- «Consultar país en la API» (ECUD3). Autor: Escobar Marcos -->
<vista:PanelBase x:Class="ec.edu.monster.vista.ConsultaApiPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vista="clr-namespace:ec.edu.monster.vista"
                 Padding="24,20">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Consultar país en la API" Style="{StaticResource Titulo}" />
            <TextBlock Text="Consulta REST Countries por nombre (por ejemplo «ecuador») y guarde el país elegido."
                       Style="{StaticResource Suave}" Margin="0,4,0,0" />
            <vista:Alerta x:Name="AlertaPantalla" Margin="0,12,0,0" />
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="Guardar" DockPanel.Dock="Right" Content="Guardar" Style="{StaticResource BotonPrimario}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Nombre del país" Style="{StaticResource Etiqueta}" />
                <TextBox x:Name="Nombre" Width="260" Margin="8,0" />
                <Button x:Name="Consultar" Content="Consultar" Style="{StaticResource BotonPrimario}" />
            </StackPanel>
        </DockPanel>
        <DataGrid x:Name="Tabla" Style="{StaticResource Tabla}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" />
                <DataGridTextColumn Header="Capital" Binding="{Binding Capital}" Width="*" />
                <DataGridTextColumn Header="Región" Binding="{Binding Region}" Width="0.7*" />
                <DataGridTextColumn Header="Subregión" Binding="{Binding SubRegion}" Width="*" />
                <DataGridTextColumn Header="Población" Width="0.8*" SortMemberPath="Poblacion"
                                    Binding="{Binding Poblacion, Converter={StaticResource FormatoNumero}}"
                                    HeaderStyle="{StaticResource EncabezadoNumero}" ElementStyle="{StaticResource TextoNumero}" />
                <DataGridTextColumn Header="Área (km²)" Width="0.8*" SortMemberPath="Area"
                                    Binding="{Binding Area, Converter={StaticResource FormatoNumero}}"
                                    HeaderStyle="{StaticResource EncabezadoNumero}" ElementStyle="{StaticResource TextoNumero}" />
                <DataGridTextColumn Header="Moneda" Binding="{Binding Moneda}" Width="1.2*" />
                <DataGridTextColumn Header="¿Guardado?" Binding="{Binding Guardado, Converter={StaticResource SiNo}}"
                                    Width="0.6*" SortMemberPath="Guardado" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</vista:PanelBase>
