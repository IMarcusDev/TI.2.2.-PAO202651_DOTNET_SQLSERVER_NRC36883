<!-- Inicio de sesión (ECUD1): usuario, clave oculta y botón «Ingresar» (también con Enter). Autor: Escobar Marcos -->
<UserControl x:Class="ec.edu.monster.vista.LoginPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vista="clr-namespace:ec.edu.monster.vista"
             Background="{StaticResource Fondo}">
    <Border Style="{StaticResource Tarjeta}" Width="420" Padding="32,28" HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="CountryAPI" Style="{StaticResource Titulo}" />
            <TextBlock Text="Consumo de APIs públicas · Inicie sesión para continuar" Style="{StaticResource Suave}" />
            <TextBlock Text="Usuario" Style="{StaticResource Etiqueta}" Margin="0,20,0,4" HorizontalAlignment="Left" />
            <TextBox x:Name="Usuario" KeyDown="AlPresionarEnUsuario" />
            <TextBlock Text="Clave" Style="{StaticResource Etiqueta}" Margin="0,12,0,4" HorizontalAlignment="Left" />
            <PasswordBox x:Name="Clave" KeyDown="AlPresionarEnClave" />
            <vista:Alerta x:Name="AlertaLogin" Margin="0,16,0,0" />
            <Button x:Name="Ingresar" Content="Ingresar" Style="{StaticResource BotonPrimario}" Height="40"
                    Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
